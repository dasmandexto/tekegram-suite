# ==== API-креды Telegram (берутся на my.telegram.org, раздел API development tools) ====
# Обязательны для запуска любых модулей, работающих с сетью.
API_ID=
API_HASH=

# ==== Пути ====
# Каталог с файлами сессий Telethon (*.session, как у TeleRaptor — по одному файлу на аккаунт)
SESSIONS_DIR=./sessions
# Файл со списком прокси (по одному на строку, формат: socks5://user:pass@host:port или host:port)
PROXIES_FILE=./proxies.txt
# Файл базы SQLite (дедуп получателей, логи, статусы аккаунтов)
DB_PATH=./data/app.db

# ==== Rate limiting (защита аккаунтов) ====
# Минимальная/максимальная пауза в секундах между действиями одного аккаунта.
# TeleRaptor рекомендует 30–90с для рассылок в ЛС, 10–20с для парсинга.
MIN_DELAY_SECONDS=30
MAX_DELAY_SECONDS=90

# ==== Планировщик ====
# Максимум одновременных задач (аккаунтов в работе).
MAX_CONCURRENCY=5
# Сколько раз повторять действие при флуд-лимите/подобных ошибках.
RETRY_ATTEMPTS=3

# ==== Инвайтер ====
# Дневной лимит приглашений на один аккаунт (Telegram банит за массовый инвайт).
INVITE_DAILY_CAP=40

# ==== Логирование ====
LOG_LEVEL=INFO
